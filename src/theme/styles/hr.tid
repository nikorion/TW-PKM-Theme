/* Monochrome SVG (follows the wiki theme): */

.tc-tiddler-frame hr {
	--logo-size: 26px;   /* size of the central logo */
	--logo-gap: 8px;     /* breathing room between rule and logo */
	opacity: 1;
	position: relative;
	width: 100%;
	height: var(--logo-size);
	margin: 0.45rem auto;
	border: 0;
	background: linear-gradient(to right, var(--nk-foreground), var(--nk-foreground))
			left  center / calc(50% - var(--logo-size) / 2 - var(--logo-gap)) 1px no-repeat,
		linear-gradient(to left,  var(--nk-foreground), var(--nk-foreground))
			right center / calc(50% - var(--logo-size) / 2 - var(--logo-gap)) 1px no-repeat;
}
.tc-tiddler-frame hr::after {
	content: "";
	position: absolute;
	inset: 0;
	background-color: var(--nk-foreground);
	mask: var(--logo-goat-mech) center / var(--logo-size) var(--logo-size) no-repeat;
}
