/* Goat icon: the SVG is the file files/logo-goat-mech.svg of the wiki (served
   at /files/ by the TW server). Pure text/css, no wikitext. Editing the icon
   means editing that file; the plugin does not ship it. */
:root {
	--logo-goat-mech: url("/files/logo-goat-mech.svg");
}


