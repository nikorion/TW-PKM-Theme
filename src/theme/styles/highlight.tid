/**
 * Obsidian style
 * ported by Alexander Marenin (http://github.com/ioncreature)
 * (highlight.js theme, see the licence note of the plugin)
 */

.hljs {
  color: var(--tpc-nk-hljs-foreground); /* light grey */
  background: var(--tpc-nk-hljs-background); /* black */
}

.hljs-keyword,
.hljs-selector-tag,
.hljs-literal,
.hljs-selector-id {
  color: var(--tpc-nk-hljs-keyword); /* light green */
}

.hljs-number {
  color: var(--tpc-nk-hljs-number); /* yellow orange */
}

.hljs-attribute {
  color: var(--tpc-nk-hljs-attribute); /* light grey blue */
}

.hljs-regexp,
.hljs-link {
  color: var(--tpc-nk-hljs-regexp); /* light brown */
}

.hljs-meta {
  color: var(--tpc-nk-hljs-meta); /* grey blue */
}

.hljs-tag,
.hljs-name,
.hljs-tag .hljs-attr,
.hljs-tag .hljs-name,
.hljs-bullet,
.hljs-subst,
.hljs-emphasis,
.hljs-type,
.hljs-built_in,
.hljs-selector-attr,
.hljs-selector-pseudo,
.hljs-addition,
.hljs-variable,
.hljs-template-tag,
.hljs-template-variable {
  color: var(--tpc-nk-hljs-tag); /* light blue green */
}

.hljs-string,
.hljs-symbol {
  color: var(--tpc-nk-hljs-string);
}

.hljs-comment,
.hljs-quote,
.hljs-deletion {
  color: var(--tpc-nk-hljs-comment); /* grey */
}

.hljs-selector-class {
  color: var(--tpc-nk-hljs-selector-class) /* purple */
}

.hljs-keyword,
.hljs-selector-tag,
.hljs-literal,
.hljs-doctag,
.hljs-title,
.hljs-section,
.hljs-type,
.hljs-name,
.hljs-strong {
  font-weight: bold;
}

.hljs-code,
.hljs-title.class_,
.hljs-class .hljs-title,
.hljs-section {
  color: var(--tpc-nk-hljs-code);
}

/* Personal addition: punctuation (JSON…) is otherwise barely visible */
.hljs-punctuation {
	color: var(--tpc-nk-hljs-comment); /* grey */
}
