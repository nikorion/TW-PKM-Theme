title: $:/plugins/nikorion/theme/styles/properties
tags: $:/tags/Stylesheet
type: text/vnd.tiddlywiki

\rules only html macrocallinline transcludeinline filteredtranscludeinline macrodef

/* CSS variables for the keys of the current palette that the core does not
   emit (it only emits the keys of the Vanilla palette): --tpc-nk-site-title… */
:root {
<$list filter="[{$:/palette}indexes[]] -[[$:/palettes/Vanilla]indexes[]]" variable="key">
	--tpc-<<key>>: <$transclude $variable="colour" $mode="inline" name=<<key>>/>;
</$list>
}
