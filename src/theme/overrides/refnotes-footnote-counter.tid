/* Override of the Kookma Refnotes stylesheet.
   Automatic counter for the fnote macro; it resets at the beginning of each tiddler. */
.tc-tiddler-frame {
  counter-reset: fnote-count katexEqnNo;
}
.refnotes-footnote {
  counter-increment: fnote-count;
}
.refnotes-footnote:after {
  content: counter(fnote-count);
  font-size:small;
 /* color:#0000ee;*/
  vertical-align: super;
  line-height: 1.5;
  color:#0000ee;
}
