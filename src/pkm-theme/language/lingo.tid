title: $:/themes/nikorion/pkm/language/lingo
tags: $:/tags/Global

\procedure theme-lingo(title)
\whitespace trim
<$let _lang={{{ [[$:/language]get[text]get[name]else[en-GB]] }}}>
<$transclude $tiddler={{{ [[$:/themes/nikorion/pkm/language/]addsuffix<_lang>addsuffix[/]addsuffix<title>] }}}>
<$transclude $tiddler={{{ [[$:/themes/nikorion/pkm/language/en-GB/]addsuffix<title>] }}}/>
</$transclude>
</$let>
\end
