/* Coloured blocks */
.info0, .interro0, .alert0{
font-size : 1.15em;
line-height: 1.5;
margin: 10px 0px; /* vertical then horizontal */
padding: 10px 10px 20px; /* top, horizontal, bottom */
border-radius: 6px;
/*font-family: patrickhand;*/
font-family: Verdana;
}
.info0{
background: linear-gradient(var(--tpc-nk-info-from), var(--tpc-nk-info-to));
color: var(--tpc-nk-info-foreground);
border: outset var(--tpc-nk-info-foreground) 1px;
}
.interro0{
background: linear-gradient(var(--tpc-nk-interro-from), var(--tpc-nk-interro-to));
color: var(--tpc-nk-interro-foreground);
border: outset var(--tpc-nk-interro-foreground) 1px;
}
.alert0{
background: linear-gradient(var(--tpc-nk-alert-from), var(--tpc-nk-alert-to));
color: var(--tpc-nk-alert-foreground);
border: outset var(--tpc-nk-alert-foreground) 1px;
}
