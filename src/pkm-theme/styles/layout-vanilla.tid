:root {
	--nk-light-background: var(--tpc-nk-light-background);
	--nk-light-border: solid 1px var(--tpc-nk-light-border);
	--nk-tiddler-border: double 4px var(--tpc-nk-tiddler-border);
}

.tc-tiddler-frame {
	border: var(--nk-tiddler-border);
}

.tc-edit-tags {
	/* Clearer edit view */
	border: none !important;
}

.tc-sidebar-scrollable {
	background: var(--nk-light-background);
	border: var(--nk-light-border);
}
